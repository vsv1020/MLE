# 麻薯背单词推送服务的配置文件
# 放在：/etc/mashu-push.env   权限：chmod 600，属主 root（systemd 以 root 身份读取它）
# 改完后执行：systemctl restart mashu-push
#
# 格式：每行 变量名=值，不要加引号，等号两边不要有空格。以 # 开头的是注释。

# ---------- 后台登录（/push-admin） ----------
# 后台用户名（浏览器弹窗登录时输入）
ADMIN_USER=admin
# 后台密码：至少 12 位，否则服务拒绝启动。建议用随机生成的长密码，例如：
#   openssl rand -hex 16
# install.sh 首次安装时会自动生成一个随机密码写在这里；留空则服务拒绝启动。
ADMIN_PASSWORD=

# ---------- Apple 推送（APNs）凭据（可选，一般不用填） ----------
# 推荐做法：这里全部留空，部署后打开 https://mle.doge6.com/push-admin → “推送设置”，
# 粘贴 .p8、填 Key ID / Team ID，点“保存并检查”。后台保存的设置优先于这里，立即生效，不用重启。
# 下面三项是备选做法：要么全部填好，要么全部留空（后台没保存时才会用这里的）。
# 两边都没有时：服务照常运行，App 可以登记设备，但后台不能真正发送（只能预览人数）。
# .p8 私钥文件路径。从 Apple Developer → Certificates, IDs & Profiles → Keys 下载的 AuthKey_XXXXXXXXXX.p8
# 放到 /etc/mashu-push/AuthKey.p8，然后执行：
#   chown mashu-push:mashu-push /etc/mashu-push/AuthKey.p8
#   chmod 600 /etc/mashu-push/AuthKey.p8
# 填好后应为：APNS_KEY_PATH=/etc/mashu-push/AuthKey.p8
APNS_KEY_PATH=
# 也可以不用文件，直接把 .p8 内容写在一行里（换行写成 \n）。两者都写时以 APNS_KEY_PATH 为准。
# APNS_KEY_P8=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----

# Key ID：10 位，就是 .p8 文件名 AuthKey_ 后面那串（也能在 Apple Developer 的 Keys 页面看到）
# 例如：APNS_KEY_ID=ABC123DEFG
APNS_KEY_ID=
# Team ID：10 位，在 Apple Developer 右上角 / Membership 页面能看到
# 例如：APPLE_TEAM_ID=TEAM123456
APPLE_TEAM_ID=

# ---------- 其他（一般不用改） ----------
# 只监听 127.0.0.1 上的这个端口，由 nginx 转发。改了的话 nginx 配置里的 8787 也要一起改。
PORT=8787
# 数据目录（设备 token、发送记录、后台保存的推送密钥 apns.json 都存在这里）。改了的话 mashu-push.service 里的路径也要改。
DATA_DIR=/var/lib/mashu-push
