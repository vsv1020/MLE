    {
      "headword": "ambiguous",
      "phonetic": "/æmˈbɪɡjuəs/",
      "cefr": "C1",
      "frequencyRank": 6120,
      "tags": [
        "academic"
      ],
      "senses": [
        {
          "partOfSpeech": "adjective",
          "definition": "having more than one possible meaning, so it is unclear which is intended",
          "translations": {
            "zh": "模棱两可的；含义不明的"
          },
          "examples": [
            {
              "text": "The wording of the clause is ambiguous.",
              "translations": {
                "zh": "该条款的措辞含义不明。"
