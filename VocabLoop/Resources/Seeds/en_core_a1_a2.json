    {
      "headword": "because",
      "phonetic": "/bɪˈkɒz/",
      "cefr": "A1",
      "frequencyRank": 91,
      "senses": [
        {
          "partOfSpeech": "conjunction",
          "definition": "for the reason that",
          "translations": { "zh": "因为" },
          "examples": [
            { "text": "I stayed home because it was raining.", "translations": { "zh": "因为下雨，我留在家里。" } }
          ],
          "usageNote": "In writing, avoid starting a sentence with 'Because' unless the main clause follows: 'Because it rained, we stayed in.'"
        }
      ]
    },
