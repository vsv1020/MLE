  "entries": [
    {
      "headword": "achieve",
      "phonetic": "/əˈtʃiːv/",
      "cefr": "B1",
      "frequencyRank": 1055,
      "senses": [
        {
          "partOfSpeech": "verb",
          "definition": "to succeed in doing something, usually after effort",
          "translations": {
            "zh": "实现；取得"
          },
          "examples": [
            {
              "text": "She achieved her goal of running a marathon.",
              "translations": {
                "zh": "她实现了跑马拉松的目标。"
              }
            }
          ],
          "synonyms": [
            "accomplish",
            "attain"
          ],
          "usageNote": "You achieve a result or a goal, not an action. 'Achieve to run' is wrong."
        }
      ]
    },
    {
