   {
    "partOfSpeech": "interjection",
    "definition": "คำทักทายที่ใช้ได้ทุกเวลา",
    "translations": {
     "en": "hello, goodbye",
     "zh": "你好；再见"
    },
    "examples": [
     {
      "text": "สวัสดีครับ",
      "translations": {
       "en": "Hello (said by a man).",
       "zh": "你好（男性用语）。"
      }
     }
    ],
    "usageNote": "句末加 ครับ（男性）或 ค่ะ（女性）显得礼貌，不加听起来比较生硬。"
   }
  ]
 },
